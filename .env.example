# HEZO CRM Production & Development Environment Variables
# Copy these variables into your local .env file or your deployment hosting platform (Vercel, Netlify, Cloudflare Pages, etc.)

# Public Frontend Variables (Safe to expose to browser)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server-Side Privileged Variables (NEVER expose to browser, MUST be server-side only)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_or_secret_key_here
